# Optional environment variables — the editor works without any of these

# Google Maps API key (enables address search)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Dev server port (default: 3000)
# PORT=3000

# Core Remodel scene storage (required for persistent storage on Vercel)
# CORE_REMODEL_API_URL=https://core-remodel.hacolby.workers.dev
# CORE_REMODEL_API_TOKEN=loaded-from-WORKER_API_KEY-via-tokens-cli
# PASCAL_SCENE_API_TOKEN=loaded-from-WORKER_API_KEY-via-tokens-cli

# Cloudflare Browser Rendering + Images screenshot workflow
# Load all server credentials locally without writing secrets: bun run dev:tokens or bun run mcp:tokens
# CLOUDFLARE_ACCOUNT_ID=loaded-from-tokens-cli
# CLOUDFLARE_WRANGLER_API_TOKEN=loaded-from-tokens-cli
# PASCAL_EDITOR_BASE_URL=https://your-editor.vercel.app
# Optional comma-separated additional origins accepted by capture_scene_screenshot
# PASCAL_CAPTURE_ALLOWED_ORIGINS=https://preview.example.vercel.app
